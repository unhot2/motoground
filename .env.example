# 이 파일을 복사해서 같은 폴더에 ".env.local" 이라는 이름으로 저장한 뒤 값을 채우세요.
# 값은 Supabase 대시보드 > Project Settings > API (또는 Connect 버튼) 에서 확인할 수 있습니다.
# 값을 비워두면 사이트는 예시(더미) 데이터로 동작합니다.

# Project URL (예: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_ 로 시작) 또는 anon public key
# ※ service_role / secret key 는 절대 넣지 마세요 (브라우저에 노출됩니다)
VITE_SUPABASE_PUBLISHABLE_KEY=
